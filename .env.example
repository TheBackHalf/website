# The Back Half — Row 63 account registration
# Copy to .env.local and fill in values. Never commit .env.local.

# -----------------------------------------------------------------------------
# AUTH_SECRET (required for production)
# Server-only. Used for session JWTs, OAuth state, and verification signing.
# Generate with: openssl rand -base64 32
# Do NOT expose this value in client-side code or commit it to Git.
AUTH_SECRET=

# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL
# Public canonical site URL with no trailing slash.
# Used for OAuth redirects, verification links, sitemap, and Open Graph.
#
# Local development:
#   http://localhost:3000
#
# Production — set when the approved launch domain is confirmed in deployment
# configuration. Approved brand reference in manuscript: thebackhalf.org
#   https://thebackhalf.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google Sign-In (optional until OAuth credentials are provisioned)
# Create OAuth 2.0 credentials at https://console.cloud.google.com/
# Authorized redirect URI must include:
#   {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SMTP email delivery (required for verification + password reset email)
# Uses real SMTP (nodemailer). Google Workspace for The Back Half:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=support@thebackhalf.org
#   SMTP_PASSWORD=your-16-character-app-password
#   SMTP_FROM=support@thebackhalf.org
# In development, links are logged to the server console if SMTP is incomplete
# or delivery fails. Never commit SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@thebackhalf.org
SMTP_PASSWORD=
SMTP_FROM=support@thebackhalf.org

# Optional Row 153 IMAP (defaults to SMTP_USER / smtp.gmail.com / 993)
# SUPPORT_IMAP_HOST=imap.gmail.com
# SUPPORT_IMAP_PORT=993
# SUPPORT_IMAP_USER=support@thebackhalf.org

# -----------------------------------------------------------------------------
# Row 66 — trusted privileged role assignment (server-only)
# Comma-separated emails. Never expose these lists to the client.
# Admin wins if an email appears in both lists. System cannot be assigned here.
# BH_ADMIN_EMAILS=founder@thebackhalf.org
# BH_SUPPORT_EMAILS=support@thebackhalf.org
BH_ADMIN_EMAILS=
BH_SUPPORT_EMAILS=

# -----------------------------------------------------------------------------
# Row 68 — Stripe Checkout (server-only secrets + approved price IDs)
# Use Stripe Sandbox (test mode) keys for launch readiness validation.
# Never expose STRIPE_SECRET_KEY to the client. Do not create new products/prices.
# Coupons/promotion codes are NOT enabled for launch.
#
# STRIPE_SECRET_KEY=sk_test_...   # server-only; never expose to the browser
# Approved sandbox Price IDs (do not invent replacements):
# STRIPE_PRICE_BLUEPRINT=price_1U28xOHJT6n1KQ2qyOAev08y   # $1,500 one-time
# STRIPE_PRICE_BUNDLE=price_1U29DFHJT6n1KQ2qYsTrKUsV      # $1,750 one-time
# STRIPE_PRICE_COMMUNITY=price_1U29WyHJT6n1KQ2qD7kBLfsr   # $50/month recurring
STRIPE_SECRET_KEY=
STRIPE_PRICE_BLUEPRINT=price_1U28xOHJT6n1KQ2qyOAev08y
STRIPE_PRICE_BUNDLE=price_1U29DFHJT6n1KQ2qYsTrKUsV
STRIPE_PRICE_COMMUNITY=price_1U29WyHJT6n1KQ2qD7kBLfsr

# -----------------------------------------------------------------------------
# Row 69 — Stripe webhooks (server-only)
# Local: stripe listen --forward-to localhost:3005/api/stripe/webhook
# Copy the printed whsec_... value here. Never expose to the browser.
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Blueprint personalized print (server-only)
# Optional shared secret so export/QA tooling can request a specific Architect's
# Blueprint without a browser session. Never expose to the client.
BLUEPRINT_PRINT_SECRET=

# Local QA only (never enable in production). When set to 1 in non-production,
# print routes may load a requested architectId for Blueprint population tests.
# BLUEPRINT_QA_OPEN=1

# Imani Heartbeat hosted runtime (always-on Vercel Cron)
# Server-only. Vercel sends CRON_SECRET as Authorization: Bearer <value>.
# Generate locally; add the same value in Vercel Production env. Never commit.
# CRON_SECRET=
# Optional alias accepted by the heartbeat route:
# IMANI_HEARTBEAT_SECRET=

# -----------------------------------------------------------------------------
# Fab 5 operating agents (Row 16)
# Optional. Used only if a live OpenAI model is connected later.
# Never put this value in agent instructions, traces, or client code.
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Approved production database (Row 64/65 architecture lock: Supabase Postgres)
# Already provisioned in Vercel Production. Server-only. Never expose to the
# client, prompts, traces, or chat. Do not create a second database.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=


# -----------------------------------------------------------------------------
# Imani Heartbeat Vercel machine access (Row 20)
# Project-scoped token for back-half/website only. Server-side. Never expose
# to the client, prompts, traces, or chat. Do not use the Founder CLI session
# as Imani's identity.
# VERCEL_TOKEN=

# Optional path override for isolated Row 84 mechanical tests only.
# Production launch KPI reporting uses Supabase Postgres (POSTGRES_URL).
# MARKETING_KPI_DB_FILE=

# Optional path override for isolated Row 150 mechanical tests / local fixtures.
# Production analytics uses Supabase Postgres (POSTGRES_URL). Do not treat
# .data/analytics/database.json as the production system of record.
# ANALYTICS_DB_FILE=

# Optional path override for the daily launch dashboard store (Row 151).
# Default: .data/launch-dashboard/database.json
# LAUNCH_DASHBOARD_DB_FILE=
